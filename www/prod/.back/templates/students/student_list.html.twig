{% extends "dashboard/layout.html.twig" %}

{% block title %}Gestion des Étudiants — StageFlow{% endblock %}

{% block dashboard_content %}
    <div class="page-header">
        <div>
            <h1>Annuaire des Étudiants</h1>
            <p>Gérez les profils et les inscriptions aux promotions.</p>
        </div>
        <div>
            <a href="/dashboard/etudiants/new" class="btn btn-primary">+ Nouvel étudiant</a>
        </div>
    </div>

    {# --- BARRE DE RECHERCHE (Consistent with Pilots/Campus) --- #}
    <form method="GET" action="/dashboard/etudiants" class="search-bar">
        <div class="form-group">
            <label>Recherche</label>
            <input type="text" name="name" placeholder="Nom, email..." value="{{ filters.name|default('') }}">
        </div>
        <div class="form-group">
            <label>Statut recherche</label>
            <select name="status">
                <option value="">Tous les statuts</option>
                <option value="searching" {{ filters.status == 'searching' ? 'selected' : '' }}>🔍 En recherche</option>
                <option value="hired" {{ filters.status == 'hired' ? 'selected' : '' }}>✅ En poste</option>
                <option value="inactive" {{ filters.status == 'inactive' ? 'selected' : '' }}>⏸️ Inactif</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">🔍 Filtrer</button>
        <a href="/dashboard/etudiants" class="btn btn-ghost">Réinitialiser</a>
    </form>

    {% if deleted %}
        <div class="notice notice-success">
            <div class="notice-icon">✅</div>
            <p>L'étudiant a bien été supprimé.</p>
        </div>
    {% endif %}

    {# --- Notice : Dynamique avec le nombre d'étudiants --- #}
    <div class="notice notice-info">
        <div class="notice-icon">ℹ️</div>
        <p>Il y a actuellement <strong>{{ students|length }} étudiant{{ students|length > 1 ? 's' : '' }}</strong> correspondant à vos critères.</p>
    </div>

    <div class="card p-0" style="margin-top: 1rem; overflow-x: auto;">
        <table class="table">
            <thead>
                <tr>
                    <th>Étudiant</th>
                    <th>Promotion</th>
                    <th>Statut</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for s in students %}
                    <tr>
                        <td>
                            <strong>{{ s.first_name }} {{ s.last_name|upper }}</strong><br>
                            <span class="text-xs text-muted">{{ s.email }}</span>
                        </td>
                        <td>
                            <span class="text-sm">{{ s.promo_label|default('N/A') }}</span>
                        </td>
                        <td>
                            {% set st = s.status|default('')|lower %}
                            {% if st == 'hired' %}
                                <span class="badge badge-success">En poste</span>
                            {% elseif st == 'inactive' %}
                                <span class="badge">Inactif</span>
                            {% else %}
                                <span class="badge badge-warning">En recherche</span>
                            {% endif %}
                        </td>
                        <td class="text-right">
                            <div style="display:flex; gap:0.4rem; justify-content:flex-end; flex-wrap:wrap;">
                                <a href="/dashboard/applications/{{ s.id }}" class="btn btn-ghost btn-sm">Candidatures</a>
                                <a href="/dashboard/etudiants/{{ s.id }}" class="btn btn-ghost btn-sm">Gérer</a>
                                <form method="POST"
                                      action="/dashboard/etudiants/{{ s.id }}/delete"
                                      style="margin:0;"
                                      onsubmit="return confirm('Supprimer définitivement {{ s.first_name }} {{ s.last_name }} ? Cette action est irréversible.');">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                    <button type="submit" class="btn btn-ghost btn-sm" style="color: var(--error-color, #e74c3c);">Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center p-4 text-muted">
                            Aucun étudiant trouvé dans la base.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
