{% extends "dashboard/layout.html.twig" %}

{% block title %}Nouveau Pilote — StageFlow{% endblock %}

{% block dashboard_content %}
    <div class="page-header" style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 1rem; border-bottom: 1px solid var(--border-color, #eee); margin-bottom: 2rem; margin-top: 1rem;">
        <div>
            <h1 style="margin: 0; font-size: 1.8rem; font-weight: 700;">Créer un pilote</h1>
            <p class="text-muted" style="margin: 0.25rem 0 0 0;">Ajoutez un nouveau tuteur pédagogique.</p>
        </div>
    </div>

    {% if error %}<div class="notice notice-error mb-2"><p>{{ error }}</p></div>{% endif %}
    {% if success %}<div class="notice notice-success mb-2"><div class="notice-icon">✅</div><p>{{ success|raw }}</p></div>{% endif %}

    <div class="card company-form">
        <form action="/dashboard/pilotes/new" method="POST" class="card-body">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

            <div class="info-section">
                <span class="section-label">Identité</span>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="first_name">Prénom</label>
                        <input type="text" name="first_name" id="first_name" value="{{ old.first_name|default('') }}" required>
                    </div>
                    <div class="form-group">
                        <label for="last_name">Nom</label>
                        <input type="text" name="last_name" id="last_name" value="{{ old.last_name|default('') }}" required>
                    </div>
                </div>
            </div>

            <div class="info-section">
                <span class="section-label">Compte & Accès</span>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="email">Adresse Email</label>
                        <input type="email" name="email" id="email" value="{{ old.email|default('') }}" required>
                    </div>

                    <div class="form-group">
                        <label for="is_active">Statut du compte</label>
                        <select name="is_active" id="is_active">
                            <option value="1" selected>🟢 Actif (Accès autorisé)</option>
                            <option value="0">🔴 Inactif (Accès suspendu)</option>
                        </select>
                    </div>

                    <div class="form-group span-full">
                        <div class="notice notice-info">
                            <div class="notice-icon">ℹ️</div>
                            <p>Un <strong>mot de passe provisoire</strong> sera généré automatiquement et affiché une seule fois après la création. Pensez à le communiquer au pilote.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="info-section">
                <span class="section-label">Promotion & Assignation (optionnel)</span>
                <div class="form-grid">
                    <div class="form-group span-full">
                        <label for="promotion_id">Assigner à une promotion</label>
                        <select name="promotion_id" id="promotion_id">
                            <option value="">-- Aucune pour le moment --</option>
                            {% for promo in all_promotions %}
                                <option value="{{ promo.id }}" {{ old.promotion_id|default('') == promo.id ? 'selected' : '' }}>
                                    {{ promo.label }} ({{ promo.academic_year }})
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-actions" style="margin-top: 2rem; border-top: 1px solid var(--border-color, #eee); padding-top: 1.5rem; display: flex; justify-content: flex-end; gap: 1rem;">
                <a href="/dashboard/pilotes" class="btn btn-ghost">Annuler</a>
                <button type="submit" class="btn btn-primary">Créer le pilote</button>
            </div>
        </form>
    </div>
{% endblock %}
